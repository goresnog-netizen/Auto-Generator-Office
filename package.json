{
  "name": "nitz-909",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.server.json",
    "format": "prettier --write .",
    "vendor:deckcraft": "powershell -ExecutionPolicy Bypass -File scripts/vendor-deckcraft.ps1",
    "serve": "node --experimental-strip-types server/serve.ts",
    "verify:deckcraft": "node scripts/verify-deckcraft.mts",
    "verify:deckcraft:api": "node scripts/verify-api.mjs",
    "verify:deckcraft:ui": "node scripts/verify-ui.mjs",
    "verify:deckcraft:pptx": "node scripts/verifikasi-pptx.mjs",
    "verify:deckcraft:sidebar": "node scripts/verifikasi-sidebar.mjs",
    "verify:deckcraft:concurrency": "node scripts/verifikasi-konkurensi.mjs",
    "verify:deckcraft:commands": "node scripts/verifikasi-perintah.mjs",
    "verify:deckcraft:kode": "node --experimental-strip-types scripts/verifikasi-kode-deckcraft.mts",
    "verify:deckcraft:filmstrip": "node scripts/verifikasi-api-filmstrip.mjs",
    "verify:deckcraft:filmstrip:ui": "node scripts/verifikasi-ui-filmstrip.mjs",
    "verify:fitur-deckcraft": "node scripts/verifikasi-fitur-deckcraft.mjs",
    "verify:glass": "node scripts/verifikasi-kaca.mjs",
    "verify:css": "node scripts/verifikasi-css.mjs",
    "verify:auto-generate": "node scripts/verifikasi-auto-generate.mjs",
    "verify:pptx-generator": "node scripts/verifikasi-pptx-generator.mjs",
    "verify:generators": "node scripts/verifikasi-generators.mjs",
    "verify:pdf-image": "node scripts/verifikasi-pdf-gambar.mjs",
    "verify:fitur-baru": "node scripts/verifikasi-fitur-baru.mjs",
    "audit:generators": "node scripts/audit-isi-generator.mjs",
    "audit:negative": "node scripts/audit-negative-test.mjs",
    "verify:backdrop": "node scripts/verifikasi-backdrop.mjs",
    "verify:performa": "node scripts/verifikasi-performa.mjs",
    "verify:all": "powershell -ExecutionPolicy Bypass -File scripts/verifikasi-semua.ps1",
    "sync:deploy": "powershell -ExecutionPolicy Bypass -File scripts/sync-deploy.ps1",
    "verify:mermaid": "node scripts/verifikasi-mermaid.mjs",
    "pasang:mermaid": "powershell -ExecutionPolicy Bypass -File scripts/pasang-mermaid.ps1"
  },
  "dependencies": {
    "docx": "^9.10.0",
    "exceljs": "^4.4.0",
    "mermaid": "^10.0.0",
    "pdfkit": "^0.15.0",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.13.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.38",
    "prettier": "^3.3.0",
    "puppeteer": "25.15.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
