{
  // Typecheck untuk kode server (Node). Dipisah dari tsconfig.json karena
  // bundel browser tidak boleh ikut menarik tipe Node.
  //
  //   npx tsc --noEmit -p tsconfig.server.json
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["server", "src/lib/deckcraft.ts", "src/lib/deckcraft-ppt.ts", "src/types"]
}
